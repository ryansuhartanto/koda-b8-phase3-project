{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"frontend": {
			"root": "frontend/",
			"framework": "vite"
		},
		"backend": {
			"root": "backend/",
			"framework": "express",
			"buildCommand": "bun run build",
			"entrypoint": "dist/app.mjs"
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": { "service": "backend" }
		},
		{
			"source": "/(.*)",
			"destination": { "service": "frontend" }
		}
	]
}
